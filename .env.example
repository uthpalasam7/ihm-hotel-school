# Copy this file to .env for local development. Keep real secrets out of source control.

IHM_DB_NAME=ihm_hotel_school
IHM_DB_USERNAME=ihm_app
IHM_DB_PASSWORD=replace-with-local-password
IHM_DB_PORT=5432

IHM_DB_URL=jdbc:postgresql://localhost:5432/ihm_hotel_school
IHM_BACKEND_PORT=8080
IHM_FRONTEND_PORT=4200
IHM_APP_TIMEZONE=Asia/Colombo
IHM_APP_CURRENCY=LKR
IHM_STUDENT_PHOTO_STORAGE_PATH=./data/student-photos
IHM_STUDENT_PHOTO_MAX_SIZE=5MB
IHM_STUDENT_PHOTO_MAX_REQUEST_SIZE=6MB

IHM_JWT_SECRET=replace-with-at-least-64-random-characters
IHM_CARD_SECRET=replace-with-an-independent-stable-random-secret-at-least-64-characters
IHM_CARD_CONTACT_LINE="Return lost cards to IHM Hotel School"
IHM_ACCESS_TOKEN_MINUTES=15
IHM_REFRESH_TOKEN_DAYS=30
IHM_MAX_FAILED_LOGIN_ATTEMPTS=5
IHM_FAILED_LOGIN_LOCK_MINUTES=15

# Optional SMTP card email. Leave unset to keep card email disabled.
# IHM_MAIL_HOST=smtp.example.com
# IHM_MAIL_PORT=587
# IHM_MAIL_USERNAME=school@example.com
# IHM_MAIL_PASSWORD=replace-with-app-password
# IHM_MAIL_FROM=school@example.com
# IHM_MAIL_AUTH=true
# IHM_MAIL_STARTTLS=true

# Optional first-run bootstrap. The app creates this user only when no users exist.
IHM_INITIAL_ADMIN_USERNAME=admin
IHM_INITIAL_ADMIN_PASSWORD=replace-with-temporary-password
IHM_INITIAL_ADMIN_FULL_NAME="Initial Super Administrator"
IHM_INITIAL_ADMIN_EMAIL=admin@example.invalid
